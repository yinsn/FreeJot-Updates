_events_url":"https://api.github.com/users/yinsn/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":105,"digest":"sha256:5902bf2e77fbebaaff616ad6b6ec41d7ac181455f4357a10b01ba6ceb672c541","download_count":0,"created_at":"2026-09-15T14:51:32Z","updated_at":"2026-09-15T14:51:32Z","browser_download_url":"https://github.com/yinsn/FreeJot-Updates/releases/download/v0.2.11/SHA256SUMS"},{"url":"https://api.github.com/repos/yinsn/FreeJot-Updates/releases/assets/565903989","id":565903989,"node_id":"RA_kwDOUZPJh84huwJ1","name":"UPDATE.zh-CN.txt","label":"","uploader":{"login":"yinsn","id":102125674,"node_id":"U_kgDOBhZQag","avatar_url":"https://avatars.githubusercontent.com/u/102125674?v=4","gravatar_id":"","url":"https://api.github.com/users/yinsn","html_url":"https://github.com/yinsn","followers_url":"https://api.github.com/users/yinsn/followers","following_url":"https://api.github.com/users/yinsn/following{/other_user}","gists_url":"https://api.github.com/users/yinsn/gists{/gist_id}","starred_url":"https://api.github.com/users/yinsn/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/yinsn/subscriptions","organizations_url":"https://api.github.com/users/yinsn/orgs","repos_url":"https://api.github.com/users/yinsn/repos","events_url":"https://api.github.com/users/yinsn/events{/privacy}","received_events_url":"https://api.github.com/users/yinsn/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1689,"digest":"sha256:4548996dacc4d975f3aee8224cb0086709212bb14769846fdfd1a6b480d9a774","download_count":0,"created_at":"2026-09-15T14:51:32Z","updated_at":"2026-09-15T14:51:32Z","browser_download_url":"https://github.com/yinsn/FreeJot-Updates/releases/download/v0.2.11/UPDATE.zh-CN.txt"}],"tarball_url":"https://api.github.com/repos/yinsn/FreeJot-Updates/tarball/v0.2.11","zipball_url":"https://api.github.com/repos/yinsn/FreeJot-Updates/zipball/v0.2.11","body":"# 释手 0.2.11 · 数字统一使用阿拉伯数字\n\n构建：20260915-144724（UTC）\n\n## 本次改动\n\n- **明确数字统一格式**：数量、日期、序号、编号、小数、百分比及分数优先输出为阿拉伯数字。例如 `三个` → `3 个`、`两百元` → `200 元`、`百分之十二点五` → `12.5%`、`F 十六` → `F16`。电话号码和验证码保留前导零。\n- **所有模式生效**：智能整理、规则整理、跳过整理和模型回退都会执行数字格式处理，并沿用中英文空格规则。\n- **保留固定表达**：“一起”“万一”“每一个”“三心二意”、星期名称和明确引用的汉字保持原样。“三五天”“十几个”“一百二”等含糊数量不猜测数值。\n- **等值改写能通过校验**：中文数字与阿拉伯数字按统一后的数值比较；继续拒绝数字、正负号、百分比或分数被改错。\n\n数字转换在本机完成，不需要加载整理模型。本次继续保留 0.2.10 的英文纠偏与中英文空格处理，模型文件不变。\n\n## 更新方法\n\n- **0.2.2 或更新版本**：打开「设置 → 关于释手 → 检查更新 → 下载并更新」。\n- **0.2.1 或更早版本**：下载本次轻量更新包，退出释手，运行包内的 `FreeJotUpdater.app`，选择原来的完整离线应用，可直接升级到 0.2.11。\n- **新 Mac 首次安装**：按[完整安装指南](https://yinsn.github.io/FreeJot-Updates/INSTALL.md)安装含模型的 0.2.4 完整包，再在应用内更新到 0.2.11。\n\n更新保留本机模型、个人词典、听写历史和已保存设置。完成后在「关于释手」核对版本与构建号。\n"}